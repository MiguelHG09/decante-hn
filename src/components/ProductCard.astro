---
const { producto } = Astro.props;
const estaAgotado = producto.variantes.every(v => !v.en_stock);
---

<a href={`/producto/${producto.id}`} class="group flex flex-col relative block">
    <div class="bg-[#f0eded] aspect-square mb-6 overflow-hidden flex items-center justify-center p-6 transition-transform duration-500 group-hover:scale-[1.02] relative">
        <img 
            src={producto.imagen} 
            alt={producto.nombre} 
            class="w-full h-full object-contain mix-blend-multiply transition-transform duration-700 group-hover:scale-110" 
        />
        
        {estaAgotado && (
            <div class="absolute inset-0 flex items-center justify-center bg-white/40 backdrop-blur-[2px]">
                <span class="bg-[#002d04] text-white px-6 py-2 font-sans text-sm font-semibold tracking-widest uppercase">AGOTADO</span>
            </div>
        )}
    </div>
    
    <span class="font-sans text-[14px] font-semibold text-[#5d5f5d] uppercase tracking-widest mb-2">{producto.marca}</span>
    <h3 class="font-serif text-[24px] text-[#001501] mb-2 line-clamp-1">{producto.nombre}</h3>
    <span class="font-sans text-[20px] font-medium text-[#002d04] mt-auto">
        {estaAgotado ? 'Agotado' : `L. ${producto.precio_base}`}
    </span>
</a>