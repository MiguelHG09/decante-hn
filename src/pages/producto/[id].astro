---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";

export function getStaticPaths() {
    const productosGlob = import.meta.glob("../../data/productos/*.json", {
        eager: true,
    });
    const productos = Object.values(productosGlob).map(
        (file: any) => file.default,
    );

    // Agregamos ': any' a producto para evitar otro error de TypeScript
    return productos.map((producto: any) => ({
        params: { id: producto.id },
        props: { producto, todosLosProductos: productos },
    }));
}

const { producto, todosLosProductos } = Astro.props;
const relacionados = todosLosProductos
    .filter((p: any) => p.id !== producto.id)
    .slice(0, 4);

// FIX TYPESCRIPT: Agregamos '(n: string)' para que TS sepa qué es.
const notasOlfativasArray =
    typeof producto.notas_olfativas === "string"
        ? producto.notas_olfativas.split(",").map((n: string) => n.trim())
        : producto.notas_olfativas || [];
---

<Layout title={producto.nombre}>
    <main
        class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12"
    >
        <section
            class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-section-gap"
        >
            <!-- Area de la imagen dinamica-->
            <div
                class="bg-surface-container aspect-square relative flex items-center justify-center p-8 transition-opacity duration-300"
            >
                <img
                    id="imagen-principal"
                    src={producto.imagen}
                    alt={producto.nombre}
                    class="w-full h-full object-contain mix-blend-multiply transition-all duration-300"
                />
            </div>

            <div
                class="flex flex-col justify-center px-0 md:px-8"
                id="pdp-container"
            >
                <span
                    class="font-sans text-[14px] font-semibold text-secondary uppercase tracking-[0.15em] mb-4"
                    >{producto.marca}</span
                >
                <h1
                    class="font-serif text-[40px] md:text-[48px] text-primary mb-6 leading-tight"
                >
                    {producto.nombre}
                </h1>

                <!-- TAGS CLICKABLES QUE LLEVAN AL CATALOGO -->
                {
                    notasOlfativasArray.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-8">
                            {notasOlfativasArray.map((nota: string) => (
                                <a
                                    href={`/catalogo?nota=${encodeURIComponent(nota)}`}
                                    class="px-4 py-1.5 border border-outline-variant text-secondary font-sans text-[11px] font-semibold uppercase tracking-[0.1em] bg-[#f6f3f2] hover:bg-primary-container hover:text-white transition-colors cursor-pointer"
                                >
                                    {nota}
                                </a>
                            ))}
                        </div>
                    )
                }

                <p
                    class="font-sans text-[16px] text-on-surface-variant mb-8 leading-relaxed max-w-lg"
                >
                    {producto.descripcion}
                </p>

                <!-- Variantes con Data-Imagen -->
                <div class="mb-8">
                    <span
                        class="font-sans text-[12px] font-semibold text-primary uppercase tracking-[0.1em] block mb-4"
                        >Tamaño</span
                    >
                    <div class="flex flex-wrap gap-4" id="contenedor-variantes">
                        {
                            producto.variantes &&
                                producto.variantes.map(
                                    (variante: any, index: number) => (
                                        <button
                                            type="button"
                                            class={`btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer ${
                                                index === 0
                                                    ? "bg-primary border-primary text-white"
                                                    : "bg-transparent border-outline-variant text-secondary hover:border-primary hover:text-primary"
                                            }`}
                                            data-precio={variante.precio}
                                            data-tamaño={variante.tamaño}
                                            data-imagen={
                                                variante.imagen_variante ||
                                                producto.imagen
                                            }
                                        >
                                            {variante.tamaño}
                                        </button>
                                    ),
                                )
                        }
                    </div>
                </div>

                <!-- Acciones -->
                <div class="flex items-end gap-4 mt-auto">
                    <div class="flex flex-col gap-2">
                        <span
                            class="font-sans text-[12px] font-semibold text-secondary uppercase tracking-[0.1em]"
                            >Cantidad</span
                        >
                        <div
                            class="flex items-center border border-outline-variant h-14 w-32 bg-white"
                        >
                            <button
                                id="pdp-minus"
                                class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light"
                                >-</button
                            >
                            <span
                                id="pdp-qty"
                                class="font-sans text-[16px] text-primary w-10 text-center font-medium"
                                >1</span
                            >
                            <button
                                id="pdp-plus"
                                class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light"
                                >+</button
                            >
                        </div>
                    </div>

                    <button
                        id="btn-agregar-carrito"
                        class="flex-1 h-14 bg-primary-container text-white font-sans text-[13px] font-semibold uppercase tracking-[0.1em] hover:bg-primary transition-colors flex items-center justify-center gap-2"
                        data-id={producto.id}
                        data-nombre={producto.nombre}
                    >
                        AGREGAR AL CARRITO - L. <span id="pdp-btn-price"
                            >{producto.variantes[0]?.precio}</span
                        >
                    </button>
                </div>
            </div>
        </section>

        <!-- Productos Relacionados -->
        {
            relacionados.length > 0 && (
                <section class="mb-section-gap">
                    <h2 class="font-headline-md text-headline-md text-primary mb-12 text-center md:text-left">
                        También te podría gustar
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
                        {relacionados.map((rel: any) => (
                            <ProductCard producto={rel} />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
</Layout>

<script>
    import { addCartItem } from "../../store/cartStore.js";

    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("pdp-container");

        if (container) {
            const variantButtons = container.querySelectorAll(
                ".btn-variante",
            ) as NodeListOf<HTMLButtonElement>;
            const qtyDisplay = document.getElementById("pdp-qty");
            const priceDisplay = document.getElementById("pdp-btn-price");
            const addToCartBtn = document.getElementById("btn-agregar-carrito");
            const imagenPrincipal = document.getElementById(
                "imagen-principal",
            ) as HTMLImageElement;

            let currentQty = 1;
            let currentPrice = parseInt(
                variantButtons[0]?.getAttribute("data-precio") || "0",
            );
            let currentVariant =
                variantButtons[0]?.getAttribute("data-tamaño") || "";
            let currentImagen =
                variantButtons[0]?.getAttribute("data-imagen") ||
                imagenPrincipal.src;

            const claseActiva =
                "btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer bg-primary border-primary text-white";
            const claseInactiva =
                "btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer bg-transparent border-outline-variant text-secondary hover:border-primary hover:text-primary";

            function updatePriceUI() {
                if (priceDisplay)
                    priceDisplay.innerText = (
                        currentPrice * currentQty
                    ).toString();
            }

            variantButtons.forEach((btn) => {
                // CAMBIAR IMAGEN AL PASAR EL MOUSE
                const cambiarImagen = function () {
                    const nuevaImg = btn.getAttribute("data-imagen");
                    if (nuevaImg && imagenPrincipal.src !== nuevaImg) {
                        imagenPrincipal.style.opacity = "0";
                        setTimeout(() => {
                            imagenPrincipal.src = nuevaImg;
                            imagenPrincipal.style.opacity = "1";
                        }, 150);
                    }
                };

                btn.addEventListener("mouseenter", cambiarImagen);

                btn.addEventListener("click", function () {
                    variantButtons.forEach(
                        (b) => (b.className = claseInactiva),
                    );
                    this.className = claseActiva;

                    currentPrice = parseInt(
                        this.getAttribute("data-precio") || "0",
                    );
                    currentVariant = this.getAttribute("data-tamaño") || "";
                    currentImagen =
                        this.getAttribute("data-imagen") || currentImagen;

                    cambiarImagen(); // Asegura el cambio en tactil osea al pasar el teclado
                    updatePriceUI();
                });
            });

            document
                .getElementById("pdp-plus")
                ?.addEventListener("click", () => {
                    currentQty++;
                    if (qtyDisplay)
                        qtyDisplay.innerText = currentQty.toString();
                    updatePriceUI();
                });

            document
                .getElementById("pdp-minus")
                ?.addEventListener("click", () => {
                    if (currentQty > 1) {
                        currentQty--;
                        if (qtyDisplay)
                            qtyDisplay.innerText = currentQty.toString();
                        updatePriceUI();
                    }
                });

            addToCartBtn?.addEventListener("click", () => {
                if (currentVariant === "") return;
                addCartItem({
                    id: addToCartBtn.getAttribute("data-id"),
                    nombre: addToCartBtn.getAttribute("data-nombre"),
                    imagen: currentImagen, // Usa la imagen exacta de la variante
                    tamaño: currentVariant,
                    precio: currentPrice,
                    cantidad: currentQty,
                });
                document
                    .getElementById("cart-sidebar")
                    ?.classList.remove("translate-x-full");
                document
                    .getElementById("cart-overlay")
                    ?.classList.remove("hidden");
            });
        }
    });
</script>
