---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productos from '../../data/productos.json';

export function getStaticPaths() {
  return productos.map((producto) => ({
    params: { id: producto.id },
    props: { producto },
  }));
}

const { producto } = Astro.props;
const relacionados = productos.filter(p => p.id !== producto.id).slice(0, 4);
---

<Layout title={producto.nombre}>
    <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
        <section class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-section-gap">
            
            <!-- Área de la Imagen -->
            <div class="bg-surface-container aspect-square relative flex items-center justify-center p-8">
                <img src={producto.imagen} alt={producto.nombre} class="w-full h-full object-contain mix-blend-multiply" />
            </div>
            
            <!-- Área de Detalles -->
            <div class="flex flex-col justify-center px-0 md:px-8" id="pdp-container">
                <span class="font-label-md text-label-md text-secondary uppercase tracking-widest mb-4">{producto.marca}</span>
                <h1 class="font-headline-lg text-headline-lg text-primary mb-6">{producto.nombre}</h1>
                
                <!-- RENDERIZADO DE NOTAS OLFATIVAS -->
                {producto.notas_olfativas && producto.notas_olfativas.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-8">
                        {producto.notas_olfativas.map(nota => (
                            <span class="px-4 py-1 border border-outline-variant text-secondary font-label-md text-[12px] uppercase tracking-widest bg-surface-bright">
                                {nota}
                            </span>
                        ))}
                    </div>
                )}

                <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed max-w-lg">
                    {producto.descripcion || "Una masterclass en quiet luxury. Rare oud wood, exotic spices, and cardamom blend seamlessly to create an intoxicating, smoky aroma."}
                </p>
                
                <!-- Variantes -->
                <div class="mb-8">
                    <span class="font-label-md text-label-md text-primary uppercase block mb-4">Tamaño</span>
                    <div class="flex flex-wrap gap-4" id="variant-selector">
                        {producto.variantes.map((variante, index) => (
                            <button 
                                class={`variant-btn px-6 py-3 font-label-md text-label-md uppercase tracking-wider border transition-colors ${index === 0 && variante.en_stock ? 'bg-primary text-on-primary border-primary active-variant' : 'border-outline-variant text-secondary hover:border-primary hover:text-primary'} ${!variante.en_stock ? 'opacity-50 cursor-not-allowed line-through' : 'cursor-pointer'}`}
                                data-tamaño={variante.tamaño}
                                data-precio={variante.precio}
                                disabled={!variante.en_stock}
                            >
                                {variante.tamaño}
                            </button>
                        ))}
                    </div>
                </div>
                
                <!-- Acciones -->
                <div class="flex items-end gap-4 mt-auto">
                    <div class="flex flex-col gap-2">
                        <span class="font-label-md text-label-md text-secondary uppercase">Cantidad</span>
                        <div class="flex items-center border border-outline-variant h-14 w-32 bg-white">
                            <button id="pdp-minus" class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light">-</button>
                            <span id="pdp-qty" class="font-body-lg text-body-lg text-primary w-10 text-center font-medium">1</span>
                            <button id="pdp-plus" class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light">+</button>
                        </div>
                    </div>
                    <button 
                        id="pdp-add-to-cart" 
                        class="flex-1 h-14 bg-primary-container text-on-primary font-label-md text-label-md uppercase tracking-wider hover:bg-primary transition-colors flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
                        data-id={producto.id}
                        data-nombre={producto.nombre}
                        data-imagen={producto.imagen}
                    >
                        Agregar al Carrito - L. <span id="pdp-btn-price">{producto.variantes.find(v => v.en_stock)?.precio || 0}</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Productos Relacionados -->
        {relacionados.length > 0 && (
            <section class="mb-section-gap">
                <h2 class="font-headline-md text-headline-md text-primary mb-12 text-center md:text-left">También te podría gustar</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
                    {relacionados.map((rel) => (
                        <ProductCard producto={rel} />
                    ))}
                </div>
            </section>
        )}
    </main>
</Layout>

<script>
    import { addCartItem } from '../../store/cartStore.js';

    const container = document.getElementById('pdp-container');
    
    if (container) {
        let currentQty = 1;
        const initialActiveBtn = container.querySelector('.variant-btn.active-variant');
        let currentPrice = initialActiveBtn ? parseInt(initialActiveBtn.dataset.precio) : 0;
        let currentVariant = initialActiveBtn ? initialActiveBtn.dataset.tamaño : '';

        const qtyDisplay = document.getElementById('pdp-qty');
        const priceDisplay = document.getElementById('pdp-btn-price');
        const addToCartBtn = document.getElementById('pdp-add-to-cart');
        const variantButtons = container.querySelectorAll('.variant-btn');

        variantButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                if (btn.disabled) return;
                variantButtons.forEach(b => {
                    b.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-variant');
                    b.classList.add('border-outline-variant', 'text-secondary');
                });
                btn.classList.remove('border-outline-variant', 'text-secondary');
                btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-variant');
                currentVariant = btn.dataset.tamaño;
                currentPrice = parseInt(btn.dataset.precio);
                updatePriceUI();
            });
        });

        document.getElementById('pdp-plus').addEventListener('click', () => {
            currentQty++;
            qtyDisplay.innerText = currentQty;
            updatePriceUI();
        });

        document.getElementById('pdp-minus').addEventListener('click', () => {
            if (currentQty > 1) {
                currentQty--;
                qtyDisplay.innerText = currentQty;
                updatePriceUI();
            }
        });

        function updatePriceUI() {
            if(priceDisplay) priceDisplay.innerText = currentPrice * currentQty;
        }

        addToCartBtn.addEventListener('click', () => {
            if(currentVariant === '') return;
            addCartItem({
                id: addToCartBtn.dataset.id,
                nombre: addToCartBtn.dataset.nombre,
                imagen: addToCartBtn.dataset.imagen,
                tamaño: currentVariant,
                precio: currentPrice,
                cantidad: currentQty
            });
            document.getElementById('cart-sidebar').classList.remove('translate-x-full');
            document.getElementById('cart-overlay').classList.remove('hidden');
        });
    }
</script>