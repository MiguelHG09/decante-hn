---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';

export function getStaticPaths() {
  const productosGlob = import.meta.glob('../../data/productos/*.json', { eager: true });
  const productos = Object.values(productosGlob).map((file: any) => file.default);

  return productos.map((producto) => ({
    params: { id: producto.id },
    props: { producto, todosLosProductos: productos },
  }));
}

const { producto, todosLosProductos } = Astro.props;
const relacionados = todosLosProductos.filter((p: any) => p.id !== producto.id).slice(0, 4);

// Convertimos el texto "Vainilla, Lavanda" del CMS en etiquetas separadas (Tags)
const notasOlfativasArray = typeof producto.notas_olfativas === 'string' 
    ? producto.notas_olfativas.split(',').map(n => n.trim()) 
    : (producto.notas_olfativas || []);
---

<Layout title={producto.nombre}>
    <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
        <section class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-section-gap">
            
            <!-- Área de la Imagen -->
            <div class="bg-surface-container aspect-square relative flex items-center justify-center p-8">
                <img src={producto.imagen} alt={producto.nombre} class="w-full h-full object-contain mix-blend-multiply" />
            </div>
            
            <!-- Área de Detalles -->
            <div class="flex flex-col justify-center px-0 md:px-8" id="pdp-container">
                <span class="font-sans text-[14px] font-semibold text-secondary uppercase tracking-[0.15em] mb-4">{producto.marca}</span>
                <h1 class="font-serif text-[40px] md:text-[48px] text-primary mb-6 leading-tight">{producto.nombre}</h1>
                
                <!-- RENDERIZADO DE NOTAS OLFATIVAS COMO TAGS -->
                {notasOlfativasArray.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-8">
                        {notasOlfativasArray.map((nota: string) => (
                            <span class="px-4 py-1.5 border border-outline-variant text-secondary font-sans text-[11px] font-semibold uppercase tracking-[0.1em] bg-[#f6f3f2]">
                                {nota}
                            </span>
                        ))}
                    </div>
                )}

                <p class="font-sans text-[16px] text-on-surface-variant mb-8 leading-relaxed max-w-lg">
                    {producto.descripcion || "Una masterclass en quiet luxury. Rare oud wood, exotic spices, and cardamom blend seamlessly to create an intoxicating, smoky aroma."}
                </p>
                
                <!-- Variantes / Tamaños -->
                <div class="mb-8">
                    <span class="font-sans text-[12px] font-semibold text-primary uppercase tracking-[0.1em] block mb-4">Tamaño</span>
                    <div class="flex flex-wrap gap-4" id="contenedor-variantes">
                        {producto.variantes && producto.variantes.map((variante: any, index: number) => (
                            <button
                                type="button"
                                class={`btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer ${
                                    index === 0
                                    ? 'bg-primary border-primary text-white' // El primero siempre activo por defecto
                                    : 'bg-transparent border-outline-variant text-secondary hover:border-primary hover:text-primary' // Los demás inactivos
                                }`}
                                data-precio={variante.precio}
                                data-tamaño={variante.tamaño}
                            >
                                {variante.tamaño}
                            </button>
                        ))}
                    </div>
                </div>
                
                <!-- Acciones (Cantidad y Carrito) -->
                <div class="flex items-end gap-4 mt-auto">
                    <div class="flex flex-col gap-2">
                        <span class="font-sans text-[12px] font-semibold text-secondary uppercase tracking-[0.1em]">Cantidad</span>
                        <div class="flex items-center border border-outline-variant h-14 w-32 bg-white">
                            <button id="pdp-minus" class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light">-</button>
                            <span id="pdp-qty" class="font-sans text-[16px] text-primary w-10 text-center font-medium">1</span>
                            <button id="pdp-plus" class="flex-1 h-full text-secondary hover:text-primary transition-colors flex items-center justify-center cursor-pointer text-2xl font-light">+</button>
                        </div>
                    </div>
                    
                    <button 
                        id="btn-agregar-carrito" 
                        class="flex-1 h-14 bg-primary-container text-white font-sans text-[13px] font-semibold uppercase tracking-[0.1em] hover:bg-primary transition-colors flex items-center justify-center gap-2"
                        data-id={producto.id}
                        data-nombre={producto.nombre}
                        data-imagen={producto.imagen}
                    >
                        AGREGAR AL CARRITO - L. <span id="pdp-btn-price">{producto.variantes[0].precio}</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Productos Relacionados -->
        {relacionados.length > 0 && (
            <section class="mb-[120px] mt-16 border-t border-outline-variant pt-16">
                <h2 class="font-serif text-[32px] text-primary mb-12 text-center">También te podría gustar</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {relacionados.map((rel: any) => (
                        <ProductCard producto={rel} />
                    ))}
                </div>
            </section>
        )}
    </main>
</Layout>

<script>
    import { addCartItem } from '../../store/cartStore.js';

    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('pdp-container');
        
        if (container) {
            const variantButtons = container.querySelectorAll('.btn-variante') as NodeListOf<HTMLButtonElement>;
            const qtyDisplay = document.getElementById('pdp-qty');
            const priceDisplay = document.getElementById('pdp-btn-price');
            const addToCartBtn = document.getElementById('btn-agregar-carrito');
            const btnPlus = document.getElementById('pdp-plus');
            const btnMinus = document.getElementById('pdp-minus');

            // Cargar datos iniciales del primer botón (que está activo por defecto en el HTML)
            let currentQty = 1;
            let currentPrice = parseInt(variantButtons[0]?.getAttribute('data-precio') || '0');
            let currentVariant = variantButtons[0]?.getAttribute('data-tamaño') || '';

            // Clases puras de Tailwind para los estados (así evitamos bugs de hover)
            const claseActiva = "btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer bg-primary border-primary text-white";
            const claseInactiva = "btn-variante px-6 py-3 border font-sans text-[12px] font-semibold uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer bg-transparent border-outline-variant text-secondary hover:border-primary hover:text-primary";

            function updatePriceUI() {
                if(priceDisplay) priceDisplay.innerText = (currentPrice * currentQty).toString();
            }

            // Lógica de Selección de Tamaños
            variantButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    // 1. Resetear todos los botones a inactivos usando la cadena de clases completa
                    variantButtons.forEach(b => {
                        b.className = claseInactiva;
                    });
                    
                    // 2. Poner activo solo el que recibió el clic
                    this.className = claseActiva;
                    
                    // 3. Actualizar variables de memoria
                    currentPrice = parseInt(this.getAttribute('data-precio') || '0');
                    currentVariant = this.getAttribute('data-tamaño') || '';
                    
                    // 4. Reflejar nuevo precio en la pantalla
                    updatePriceUI();
                });
            });

            // Lógica de Cantidad
            btnPlus?.addEventListener('click', () => {
                currentQty++;
                if (qtyDisplay) qtyDisplay.innerText = currentQty.toString();
                updatePriceUI();
            });

            btnMinus?.addEventListener('click', () => {
                if (currentQty > 1) {
                    currentQty--;
                    if (qtyDisplay) qtyDisplay.innerText = currentQty.toString();
                    updatePriceUI();
                }
            });

            // Lógica de Agregar al Carrito
            addToCartBtn?.addEventListener('click', () => {
                if(currentVariant === '') return;
                
                addCartItem({
                    id: addToCartBtn.getAttribute('data-id'),
                    nombre: addToCartBtn.getAttribute('data-nombre'),
                    imagen: addToCartBtn.getAttribute('data-imagen'),
                    tamaño: currentVariant,
                    precio: currentPrice,
                    cantidad: currentQty
                });
                
                // Mostrar el carrito lateral
                document.getElementById('cart-sidebar')?.classList.remove('translate-x-full');
                document.getElementById('cart-overlay')?.classList.remove('hidden');
            });
        }
    });
</script>