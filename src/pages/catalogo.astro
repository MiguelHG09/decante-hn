---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

// Magia: Astro lee todos los JSON individuales creados por el CMS
const productosGlob = import.meta.glob('../data/productos/*.json', { eager: true });
const productos = Object.values(productosGlob).map(file => file.default);

const marcasUnicas = [...new Set(productos.map(p => p.marca))];
const categoriasUnicas = [...new Set(productos.map(p => p.categoria))];
---

<Layout title="Catálogo Completo">
    <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-24">
        
        <header class="mb-16 text-center md:text-left">
            <h1 class="font-display-lg text-display-lg text-primary mb-4">Colección Completa</h1>
            <p class="font-body-lg text-body-lg text-secondary max-w-2xl">Explora nuestra cuidada selección de fragancias nicho y de diseñador. Descubre el arte de la perfumería fina, decantada con precisión y cuidado.</p>
        </header>

        <!-- Filtros -->
        <section class="flex flex-col md:flex-row gap-4 mb-section-gap border-b border-surface-container-highest pb-8">
            <!-- Filtro Categoría -->
            <div class="relative w-full md:w-64">
                <select id="filter-categoria" class="w-full appearance-none bg-transparent border border-surface-container-highest text-on-surface py-3 px-4 rounded-none font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-0 cursor-pointer transition-colors duration-300">
                    <option value="all">Todas las Categorías</option>
                    {categoriasUnicas.map(cat => <option value={cat.toLowerCase()}>{cat}</option>)}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-secondary">
                    <span class="material-symbols-outlined text-sm">expand_more</span>
                </div>
            </div>
            
            <!-- Filtro Marca -->
            <div class="relative w-full md:w-64">
                <select id="filter-marca" class="w-full appearance-none bg-transparent border border-surface-container-highest text-on-surface py-3 px-4 rounded-none font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-0 cursor-pointer transition-colors duration-300">
                    <option value="all">Todas las Marcas</option>
                    {marcasUnicas.map(marca => <option value={marca.toLowerCase()}>{marca}</option>)}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-secondary">
                    <span class="material-symbols-outlined text-sm">expand_more</span>
                </div>
            </div>
            
            <!-- Ordenar por Precio -->
            <div class="relative w-full md:w-64">
                <select id="sort-precio" class="w-full appearance-none bg-transparent border border-surface-container-highest text-on-surface py-3 px-4 rounded-none font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-0 cursor-pointer transition-colors duration-300">
                    <option value="default">Ordenar por Precio</option>
                    <option value="asc">Menor a Mayor</option>
                    <option value="desc">Mayor a Menor</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-secondary">
                    <span class="material-symbols-outlined text-sm">expand_more</span>
                </div>
            </div>
        </section>

        <!-- Cuadrícula de Productos -->
        <section id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter mb-section-gap">
            {productos.map((prod) => (
                <div 
                    class="product-item transition-opacity duration-300"
                    data-categoria={prod.categoria.toLowerCase()}
                    data-marca={prod.marca.toLowerCase()}
                    data-precio={prod.precio_base}
                >
                    <ProductCard producto={prod} />
                </div>
            ))}
        </section>

        <p id="no-results-msg" class="hidden text-center text-secondary font-body-lg mb-section-gap">No se encontraron productos con estos filtros.</p>

    </main>
</Layout>

<script>
    const filterCategoria = document.getElementById('filter-categoria');
    const filterMarca = document.getElementById('filter-marca');
    const sortPrecio = document.getElementById('sort-precio');
    const grid = document.getElementById('product-grid');
    const noResultsMsg = document.getElementById('no-results-msg');

    function applyFilters() {
        const catValue = filterCategoria.value;
        const marcaValue = filterMarca.value;
        const sortValue = sortPrecio.value;
        
        let itemsArray = Array.from(grid.querySelectorAll('.product-item'));
        let visibleCount = 0;

        // 1. Filtrar
        itemsArray.forEach(item => {
            const matchCat = catValue === 'all' || item.dataset.categoria === catValue;
            const matchMarca = marcaValue === 'all' || item.dataset.marca === marcaValue;

            if (matchCat && matchMarca) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        // 2. Ordenar los visibles
        if (sortValue !== 'default') {
            const sortedItems = itemsArray.sort((a, b) => {
                const precioA = parseInt(a.dataset.precio);
                const precioB = parseInt(b.dataset.precio);
                return sortValue === 'asc' ? precioA - precioB : precioB - precioA;
            });
            // Reinsertar en el DOM en el nuevo orden
            sortedItems.forEach(item => grid.appendChild(item));
        }

        // 3. Mostrar mensaje si no hay resultados
        if (visibleCount === 0) {
            noResultsMsg.classList.remove('hidden');
        } else {
            noResultsMsg.classList.add('hidden');
        }
    }

    // Escuchar cambios
    filterCategoria.addEventListener('change', applyFilters);
    filterMarca.addEventListener('change', applyFilters);
    sortPrecio.addEventListener('change', applyFilters);
</script>