---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contáctanos">
    <main class="flex-grow flex flex-col items-center justify-center py-[120px] px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
        
        <!-- Encabezado -->
        <div class="w-full text-center mb-16">
            <h1 class="font-serif text-[32px] md:text-[48px] font-bold text-primary mb-4 tracking-tight">Ponte en Contacto</h1>
            <p class="font-sans text-[16px] text-secondary max-w-xl mx-auto">
                Estamos aquí para asesorarte. Escríbenos a nuestras redes o a WhatsApp para atención inmediata.
            </p>
        </div>

        <!-- Tarjetas de Contacto -->
        <div class="w-full max-w-2xl flex flex-col border border-outline-variant rounded-xl overflow-hidden shadow-sm">
            
            <!-- WhatsApp -->
            <a href="https://wa.me" target="_blank" class="group flex items-center gap-6 p-6 border-b border-outline-variant hover:bg-surface-container-low transition-colors duration-300 bg-white">
                <!-- Contenedor del Icono (Fija el tamaño aquí) -->
                <div class="w-6 h-6 flex-shrink-0 text-primary transition-transform duration-300 group-hover:scale-110">
                    <svg class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    </svg>
                </div>
                <div>
                    <p class="font-sans text-[12px] font-semibold uppercase tracking-[0.1em] text-secondary mb-1">WhatsApp</p>
                    <p class="font-sans text-[18px] text-primary font-medium">+504 9869-3529</p>
                </div>
            </a>
            
            <!-- Instagram -->
            <a href="https://instagram.com" target="_blank" class="group flex items-center gap-6 p-6 border-b border-outline-variant hover:bg-surface-container-low transition-colors duration-300 bg-white">
                <!-- Contenedor del Icono -->
                <div class="w-6 h-6 flex-shrink-0 text-primary transition-transform duration-300 group-hover:scale-110">
                    <svg class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                    </svg>
                </div>
                <div>
                    <p class="font-sans text-[12px] font-semibold uppercase tracking-[0.1em] text-secondary mb-1">Instagram</p>
                    <p class="font-sans text-[18px] text-primary font-medium">@decante.hn</p>
                </div>
            </a>

            <!-- TikTok -->
            <a href="https://tiktok.com" target="_blank" class="group flex items-center gap-6 p-6 hover:bg-surface-container-low transition-colors duration-300 bg-white">
                <!-- Contenedor del Icono -->
                <div class="w-6 h-6 flex-shrink-0 text-primary transition-transform duration-300 group-hover:scale-110">
                    <svg class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
                    </svg>
                </div>
                <div>
                    <p class="font-sans text-[12px] font-semibold uppercase tracking-[0.1em] text-secondary mb-1">TikTok</p>
                    <p class="font-sans text-[18px] text-primary font-medium">@decante.hn</p>
                </div>
            </a>
            
        </div>
    </main>
</Layout>
